{
    "@context": {
        "skos": "http://www.w3.org/2004/02/skos/core#",
        "foaf": "http://xmlns.com/foaf/0.1/",
        "dcterms": "http://purl.org/dc/terms/",
        "owl": "http://www.w3.org/2002/07/owl",
        "xsd": "http://www.w3.org/2001/XMLSchema#",
        "@vocab": "http://www.w3.org/2004/02/skos/core#",
        "prefLabel": "skos:prefLabel",
        "homepage": {
            "@id": "foaf:homepage",
            "@type": "xsd:anyURI"
        },
        "deprecated": {
            "@id": "owl:deprecated",
            "@type": "xsd:boolean"
        },
        "subject": {
            "@id": "dcterms:subject",
            "@type": "@id"
        },
        "type": "dcterms:type",
        "title": "dcterms:title",
        "concepts": {
            "@id": "dcterms:hasPart",
            "@container": "@index",
            "@index": "skos:notation"
        },
        "notation": {
            "@id": "skos:notation",
            "@type": "xsd:string"
        },
        "source": {
            "@id": "dcterms:source",
            "@type": "xsd:anyURI"
        },
        "generatedBy": {
            "@id": "dcterms:generatedBy",
            "@type": "xsd:anyURI"
        },
        "inScheme": {
            "@id": "skos:inScheme",
            "@type": "@id"
        },
        "topConceptOf": {
            "@id": "skos:topConceptOf",
            "@type": "@id"
        }
    }
}
