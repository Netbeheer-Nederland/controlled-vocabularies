{
    "@context": {
        "skos": "http://www.w3.org/2004/02/skos/core#",
        "foaf": "http://xmlns.com/foaf/0.1/",
        "dcterms": "http://purl.org/dc/terms/",
        "owl": "http://www.w3.org/2002/07/owl",
        "prov": "http://www.w3.org/ns/prov#",
        "xsd": "http://www.w3.org/2001/XMLSchema#",
        "@vocab": "http://www.w3.org/2004/02/skos/core#",
        "homepage": {
            "@id": "foaf:homepage",
            "@type": "xsd:anyURI"
        },
        "deprecated": {
            "@id": "owl:deprecated",
            "@type": "xsd:boolean"
        },
        "subject": {
            "@id": "dcterms:subject",
            "@type": "@id"
        },
        "type": "dcterms:type",
        "title": {
            "@id": "dcterms:title",
            "@container": "@language"
        },
        "prefLabel": {
            "@id": "skos:prefLabel",
            "@container": "@language"
        },
        "altLabel": {
            "@id": "skos:altLabel",
            "@container": "@language"
        },
        "scopeNote": {
            "@id": "skos:scopeNote",
            "@container": "@language"
        },
        "definition": {
            "@id": "skos:definition",
            "@container": "@language"
        },
        "description": {
            "@id": "dcterms:description",
            "@container": "@language"
        },
        "notation": {
            "@id": "skos:notation",
            "@type": "xsd:string"
        },
        "source": {
            "@id": "dcterms:source",
            "@type": "xsd:anyURI"
        },
        "wasGeneratedBy": {
            "@id": "prov:wasGeneratedBy",
            "@type": "xsd:anyURI"
        },
        "inScheme": {
            "@id": "skos:inScheme",
            "@type": "@id"
        },
        "topConceptOf": {
            "@id": "skos:topConceptOf",
            "@type": "@id"
        }
    }
}
