{
  "@context": {
    "dcterms": "http://purl.org/dc/terms/",
    "owl": "http://www.w3.org/2002/07/owl#",
    "rdfs": "http://www.w3.org/2000/01/rdf-schema#",
    "sh": "http://www.w3.org/ns/shacl#",
    "skos": "http://www.w3.org/2004/02/skos/core#",
    "sh:in": {
      "@container": "@list",
      "@type": "@id"
    }
  },
  "@graph": [
    {
      "@id": "{{ scheme['@id'] }}",
      "@type": ["owl:Ontology", "sh:ShapesGraph"]
    },
    {
      "@id": "{{ scheme['@id'] }}#{{ scheme['notation'] }}Shape",
      "@type": "sh:NodeShape",
      "skos:scopeNote": "Users who wish to restrict properties to exclusively allow values from this code list can import this ontology and use this node shape.",
      "sh:in": [
        {%- for term in scheme["@graph"] if not term.get("deprecated") %}
          "{{ term["@id"] }}"{% if not loop.last %},{% endif %}
        {%- endfor %}
      ]
    }
  ]
}
